# Copy this file to .env.local and fill in the values.

# Reown AppKit / WalletConnect project id (required for wallet connection).
# Get one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# AgentRegistry contract address on Botchain Testnet.
# Set this after running `npm run deploy:contract`.
# When empty, the app falls back to the off-chain API store.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Private key of a funded Botchain Testnet account.
# Used ONLY by scripts/deploy-contract.mjs — it is never exposed to the browser
# (no NEXT_PUBLIC_ prefix). Keep this secret; do not commit .env.local.
# DEPLOYER_PRIVATE_KEY=0x...

# MongoDB connection string (optional; falls back to an in-memory store).
MONGODB_URI=
